## @file
#  Allwinner H616 / H618 silicon package.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = H616Pkg
  PACKAGE_GUID                   = 0d18347e-44a7-43ae-8ca6-862c36afd35a
  PACKAGE_VERSION                = 0.1

[Includes]
  Include

[Guids]
  gH616TokenSpaceGuid = { 0x85318c69, 0xdf1e, 0x45c1, { 0x93, 0xd4, 0x9f, 0x96, 0x5e, 0xb9, 0x9e, 0x91 } }

[Protocols]
  gSunxiCpuThermalProtocolGuid = { 0x6c2f1a9e, 0x3b7d, 0x4e51, { 0x9a, 0x0c, 0x47, 0xd2, 0x8e, 0x15, 0xb3, 0x6f } }

[PcdsFixedAtBuild]
  # SD/MMC host controller used for the boot card (SMHC0 = microSD slot)
  gH616TokenSpaceGuid.PcdSunxiMmcBase|0x04020000|UINT64|0x00000001
  gH616TokenSpaceGuid.PcdSunxiMmcIndex|0|UINT32|0x00000002
  # Upper limit for the SD card clock in Hz (PIO mode; 50 MHz = SD high speed)
  gH616TokenSpaceGuid.PcdSunxiMmcMaxClock|50000000|UINT32|0x00000003

[PcdsFeatureFlag]
  # FALSE: ignore everything arriving on UART0 RX (for setups where only TX is
  # wired, or RX is noisy). Keyboard input must then come from elsewhere.
  gH616TokenSpaceGuid.PcdSunxiUartInputEnable|FALSE|BOOLEAN|0x00000010

[PcdsFixedAtBuild]
  # SD-backed NV variable store inside the FD (see OrangePiZero2W.fdf and
  # Platform/.../Drivers/VarBlockServiceDxe). Bases are set by the FDF.
  gH616TokenSpaceGuid.PcdFirmwareBlockSize|0x1000|UINT32|0x00000020
  gH616TokenSpaceGuid.PcdNvStorageVariableBase|0x0|UINT32|0x00000021
  gH616TokenSpaceGuid.PcdNvStorageEventLogBase|0x0|UINT32|0x00000022
  gH616TokenSpaceGuid.PcdNvStorageEventLogSize|0x0|UINT32|0x00000023
  gH616TokenSpaceGuid.PcdNvStorageFtwWorkingBase|0x0|UINT32|0x00000024
  gH616TokenSpaceGuid.PcdNvStorageFtwSpareBase|0x0|UINT32|0x00000025
