+/* x64 engine: the machine's local APIC serves CR8 and the APIC base MSR */
+UNICORN_EXPORT
+void uc_x86_set_apic_hooks(struct uc_struct *uc, uint64_t (*get)(void *opaque, int what),
+                           void (*set)(void *opaque, int what, uint64_t val), void *opaque)
+{
+    uc->x86_apic_get = get;
+    uc->x86_apic_set = set;
+    uc->x86_apic_opaque = opaque;
+    if (uc->cpu) {
+        ((CPUX86State *)uc->cpu->env_ptr)->features[FEAT_1_EDX] |= CPUID_APIC;
+        /* TCG has no virtual-8086 mode extensions */
+        ((CPUX86State *)uc->cpu->env_ptr)->features[FEAT_1_EDX] &= ~CPUID_VME;
+    }
+}
+
+/* x64 engine: the CPU as it leaves reset (16-bit real mode at F000:FFF0), for a PC BIOS */
+UNICORN_EXPORT
+void uc_x86_reset_real(struct uc_struct *uc)
+{
+    CPUState *cs = uc->cpu;
+    CPUX86State *env = (CPUX86State *)cs->env_ptr;
+    int i;
+
+    env->efer = 0;
+    env->hflags &= ~(HF_LMA_MASK | HF_CS64_MASK | HF_CPL_MASK);
+    cpu_x86_update_cr4(env, 0);
+    cpu_x86_update_cr0(env, 0x60000010);
+    env->cr[2] = 0;
+    cpu_x86_update_cr3(env, 0);
+    cpu_x86_load_seg_cache(env, R_CS, 0xf000, 0xffff0000, 0xffff,
+                           DESC_P_MASK | DESC_S_MASK | DESC_CS_MASK | DESC_R_MASK | DESC_A_MASK);
+    for (i = 0; i < 6; i++) {
+        if (i != R_CS) {
+            cpu_x86_load_seg_cache(env, i, 0, 0, 0xffff,
+                                   DESC_P_MASK | DESC_S_MASK | DESC_W_MASK | DESC_A_MASK);
+        }
+    }
+    env->ldt.selector = 0; env->ldt.base = 0; env->ldt.limit = 0xffff;
+    env->ldt.flags = DESC_P_MASK | (2 << DESC_TYPE_SHIFT);
+    env->tr.selector = 0; env->tr.base = 0; env->tr.limit = 0xffff;
+    env->tr.flags = DESC_P_MASK | (11 << DESC_TYPE_SHIFT);
+    env->idt.base = 0; env->idt.limit = 0xffff;
+    env->gdt.base = 0; env->gdt.limit = 0xffff;
+    memset(env->regs, 0, sizeof(env->regs));
+    env->regs[R_EDX] = env->cpuid_version;
+    env->eip = 0xfff0;
+    cpu_load_eflags(env, 0x2, ~0);
+    env->hflags2 |= HF2_GIF_MASK;
+    env->v_tpr = 0;
+    env->tsc_offset = 0 - cpu_get_tsc(env);     /* the counter starts at zero */
+    cs->halted = 0;
+    cs->exception_index = -1;
+    cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    tlb_flush(cs);
+}
