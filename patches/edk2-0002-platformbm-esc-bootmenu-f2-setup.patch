   F2.ScanCode     = SCAN_F2;
   F2.UnicodeChar  = CHAR_NULL;
@@ -676,22 +725,42 @@ PlatformRegisterOptionsAndKeys (
   Esc.UnicodeChar = CHAR_NULL;
   Status          = EfiBootManagerGetBootManagerMenu (&BootOption);
   ASSERT_EFI_ERROR (Status);
-  Status = EfiBootManagerAddKeyOptionVariable (
-             NULL,
-             (UINT16)BootOption.OptionNumber,
-             0,
-             &F2,
-             NULL
-             );
-  ASSERT (Status == EFI_SUCCESS || Status == EFI_ALREADY_STARTED);
-  Status = EfiBootManagerAddKeyOptionVariable (
-             NULL,
-             (UINT16)BootOption.OptionNumber,
-             0,
-             &Esc,
-             NULL
-             );
-  ASSERT (Status == EFI_SUCCESS || Status == EFI_ALREADY_STARTED);
+  PlatformSetKeyOption (&F2, (UINT16)BootOption.OptionNumber);
+
+  if (!EFI_ERROR (Status)) {
+    EFI_BOOT_MANAGER_LOAD_OPTION  MenuOption;
+    EFI_BOOT_MANAGER_LOAD_OPTION  *Options;
+    UINTN                         Count;
+    INTN                          Found;
+    STATIC CONST CHAR16           Data[] = L"bootmenu";
+
+    Status = EfiBootManagerInitializeLoadOption (
+               &MenuOption,
+               LoadOptionNumberUnassigned,
+               LoadOptionTypeBoot,
+               LOAD_OPTION_CATEGORY_APP | LOAD_OPTION_ACTIVE | LOAD_OPTION_HIDDEN,
+               L"Boot Menu",
+               BootOption.FilePath,
+               (UINT8 *)Data,
+               sizeof (Data)
+               );
+    if (!EFI_ERROR (Status)) {
+      Options = EfiBootManagerGetLoadOptions (&Count, LoadOptionTypeBoot);
+      Found   = EfiBootManagerFindLoadOption (&MenuOption, Options, Count);
+      if (Found >= 0) {
+        MenuOption.OptionNumber = Options[Found].OptionNumber;
+      } else {
+        Status = EfiBootManagerAddLoadOptionVariable (&MenuOption, MAX_UINTN);
+      }
+
+      EfiBootManagerFreeLoadOptions (Options, Count);
+      if (!EFI_ERROR (Status)) {
+        PlatformSetKeyOption (&Esc, (UINT16)MenuOption.OptionNumber);
+      }
+
+      EfiBootManagerFreeLoadOption (&MenuOption);
+    }
+  }
 }
 
