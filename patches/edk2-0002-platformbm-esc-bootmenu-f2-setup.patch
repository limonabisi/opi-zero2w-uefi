+/**
+  Point the hot key Key at boot option OptionNumber, replacing an older
+  mapping of the same key (without rewriting the variable when unchanged).
+**/
+STATIC
+VOID
+PlatformSetKeyOption (
+  IN EFI_INPUT_KEY  *Key,
+  IN UINT16         OptionNumber
+  )
+{
+  CHAR16                       Name[16];
+  UINTN                        Index;
+  EFI_KEY_OPTION               *Opt;
+  UINTN                        Size;
+  BOOLEAN                      Have;
+
+  Have = FALSE;
+  for (Index = 0; Index <= 0xFF; Index++) {
+    UnicodeSPrint (Name, sizeof (Name), L"Key%04x", Index);
+    GetEfiGlobalVariable2 (Name, (VOID **)&Opt, &Size);
+    if (Opt == NULL) {
+      continue;
+    }
+
+    if ((Size >= sizeof (EFI_KEY_OPTION) + sizeof (EFI_INPUT_KEY)) &&
+        (Opt->KeyData.Options.InputKeyCount == 1) &&
+        (Opt->KeyData.PackedValue == (1U << 30)) &&
+        (CompareMem (Opt + 1, Key, sizeof (*Key)) == 0))
+    {
+      if (Opt->BootOption == OptionNumber) {
+        Have = TRUE;
+      } else {
+        EfiBootManagerDeleteKeyOptionVariable (NULL, 0, Key, NULL);
+      }
+    }
+
+    FreePool (Opt);
+  }
+
+  if (!Have) {
+    EfiBootManagerAddKeyOptionVariable (NULL, OptionNumber, 0, Key, NULL);
+  }
+}
