diff --git a/Drivers/Emulator/Emulator.c b/Drivers/Emulator/Emulator.c
index e2d9323..af6b629 100644
--- a/Drivers/Emulator/Emulator.c
+++ b/Drivers/Emulator/Emulator.c
@@ -12,6 +12,11 @@
 
 #include "Emulator.h"
 
+BOOLEAN
+EmulatorIsNativeImageAddress (
+  IN  UINT64  Address
+  );
+
 BOOLEAN
 EmulatorIsNativeCall (
   IN  UINT64  ProgramCounter
@@ -29,7 +34,55 @@ EmulatorIsNativeCall (
     return FALSE;
   }
 
-  return TRUE;
+  /*
+   * Native code lives in native (AArch64) images. Anything else reached
+   * from emulated code is emulated code outside a PE image, e.g. modules
+   * a boot loader such as GRUB loads into allocated memory.
+   */
+  return EmulatorIsNativeImageAddress (ProgramCounter);
+}
+
+BOOLEAN
+EmulatorIsNativeImageAddress (
+  IN  UINT64  Address
+  )
+{
+  STATIC EFI_DEBUG_IMAGE_INFO_TABLE_HEADER  *Table;
+  STATIC UINT64                             LastBase;
+  STATIC UINT64                             LastEnd;
+  EFI_DEBUG_IMAGE_INFO                      *Info;
+  EFI_LOADED_IMAGE_PROTOCOL                 *Li;
+  UINT32                                    Index;
+  UINT64                                    Base;
+
+  if ((Address >= LastBase) && (Address < LastEnd)) {
+    return TRUE;
+  }
+
+  if ((Table == NULL) &&
+      EFI_ERROR (EfiGetSystemConfigurationTable (&gEfiDebugImageInfoTableGuid, (VOID **)&Table)))
+  {
+    return TRUE;            // no table: keep the old behaviour
+  }
+
+  Info = Table->EfiDebugImageInfoTable;
+  for (Index = 0; Index < Table->TableSize; Index++) {
+    if ((Info[Index].NormalImage == NULL) ||
+        (Info[Index].NormalImage->ImageInfoType != EFI_DEBUG_IMAGE_INFO_TYPE_NORMAL))
+    {
+      continue;
+    }
+
+    Li   = Info[Index].NormalImage->LoadedImageProtocolInstance;
+    Base = (UINT64)(UINTN)Li->ImageBase;
+    if ((Address >= Base) && (Address < Base + Li->ImageSize)) {
+      LastBase = Base;
+      LastEnd  = Base + Li->ImageSize;
+      return TRUE;
+    }
+  }
+
+  return FALSE;
 }
 
