+/*
+ * x64 engine: one TLB and one TB jump cache per x86 PCID.
+ *
+ * Without PCIDs every CR3 write (every context switch) flushes the TLB and
+ * the jump cache; a fork/exec heavy guest then spends about half its time
+ * refilling them (page walks, get_page_addr_code, qht lookups). With
+ * CR4.PCIDE the guest itself tracks which address spaces are stale and asks
+ * for a flush only then (CR3 without bit 63, INVLPG, CR4.PGE toggles), so
+ * the TLB of a switched-out address space can be kept and switched back in.
+ * Linux uses up to 6 dynamic ASIDs, hence 7 slots (plus PCID 0).
+ */
+#define X64E_SLOTS 7
+
+static inline bool tlb_hit_page_anyprot(struct uc_struct *uc, CPUTLBEntry *tlb_entry,
+                                        target_ulong page);
+static void tlb_flush_by_mmuidx_async_work(CPUState *cpu, run_on_cpu_data data);
+static void x64e_shadow_protect(struct uc_struct *uc, ram_addr_t ram);
+static void x64e_shadow_flush_all(struct uc_struct *uc);
+static void x64e_shadow_flush_slot(struct uc_struct *uc, int slot);
+static void x64e_shadow_flush_page(struct uc_struct *uc, target_ulong addr);
+
+typedef struct X64ePcidSlot {
+    bool valid;
+    uint16_t pcid;
+    uint64_t gen;
+    uint64_t lru;
+    uint16_t dirty;
+    CPUTLBDesc d[NB_MMU_MODES];
+    CPUTLBDescFast f[NB_MMU_MODES];
+    struct TranslationBlock **jc;
+} X64ePcidSlot;
+
+typedef struct X64ePcidState {
+    X64ePcidSlot s[X64E_SLOTS];
+    int cur;
+    uint64_t gen, tick;
+    bool in_switch;
+    uint64_t switches, hits;
+} X64ePcidState;
+
+static X64ePcidState *x64e_state(CPUState *cpu)
+{
+    struct uc_struct *uc = cpu->uc;
+    CPUArchState *env = cpu->env_ptr;
+    X64ePcidState *st = uc->x64e_pcid;
+    int64_t now;
+    int i, k;
+
+    if (st) {
+        return st;
+    }
+
+    st = g_new0(X64ePcidState, 1);
+    now = get_clock_realtime();
+    st->gen = 1;
+    /* slot 0 is the live TLB as it is now */
+    st->s[0].valid = true;
+    st->s[0].pcid = 0;
+    st->s[0].gen = st->gen;
+    st->s[0].jc = cpu->tb_jmp_cache;
+    for (i = 1; i < X64E_SLOTS; i++) {
+        for (k = 0; k < NB_MMU_MODES; k++) {
+            tlb_mmu_init(&st->s[i].d[k], &st->s[i].f[k], now);
+        }
+        st->s[i].jc = g_new0(struct TranslationBlock *, TB_JMP_CACHE_SIZE + 1);
+    }
+    (void)env;
+    uc->x64e_pcid = st;
+    return st;
+}
+
+static void x64e_flush_live(CPUState *cpu, X64ePcidState *st)
+{
+    st->in_switch = true;
+    tlb_flush_by_mmuidx_async_work(cpu, RUN_ON_CPU_HOST_INT(ALL_MMUIDX_BITS));
+    st->in_switch = false;
+    x64e_shadow_flush_slot(cpu->uc, st->cur);
+}
+
+void tlb_x64e_set_pcid(CPUState *cpu, uint16_t pcid, bool flush)
+{
+    CPUArchState *env = cpu->env_ptr;
+    X64ePcidState *st = x64e_state(cpu);
+    X64ePcidSlot *cur = &st->s[st->cur];
+    int i, j = -1;
+    bool stale = false;
+
+    if (cur->pcid == pcid) {
+        if (flush) {
+            x64e_flush_live(cpu, st);
+        }
+        return;
+    }
+
+    for (i = 0; i < X64E_SLOTS; i++) {
+        if (i != st->cur && st->s[i].valid && st->s[i].pcid == pcid) {
+            j = i;
+            break;
+        }
+    }
+
+    if (j < 0) {
+        /* least recently used slot (a never used one first) */
+        uint64_t best = UINT64_MAX;
+
+        for (i = 0; i < X64E_SLOTS; i++) {
+            uint64_t age = st->s[i].valid ? st->s[i].lru : 0;
+            if (i != st->cur && age < best) {
+                best = age;
+                j = i;
+            }
+        }
+        stale = true;
+    } else {
+        st->hits++;
+    }
+    st->switches++;
+
+    /* save the live TLB into the current slot, load the new one */
+    memcpy(cur->d, env_tlb(env)->d, sizeof(cur->d));
+    memcpy(cur->f, env_tlb(env)->f, sizeof(cur->f));
+    cur->dirty = env_tlb(env)->c.dirty;
+    cur->gen = st->gen;
+
+    memcpy(env_tlb(env)->d, st->s[j].d, sizeof(cur->d));
+    memcpy(env_tlb(env)->f, st->s[j].f, sizeof(cur->f));
+    env_tlb(env)->c.dirty = st->s[j].valid ? st->s[j].dirty : ALL_MMUIDX_BITS;
+    cpu->tb_jmp_cache = st->s[j].jc;
+    if (!st->s[j].valid || st->s[j].gen != st->gen) {
+        stale = true;
+    }
+
+    st->cur = j;
+    st->s[j].valid = true;
+    st->s[j].pcid = pcid;
+    st->s[j].lru = ++st->tick;
+
+    if (stale || flush) {
+        env_tlb(env)->c.dirty = ALL_MMUIDX_BITS;
+        x64e_flush_live(cpu, st);
+    }
+}
+
+/* INVLPG & co: the page must also go from the saved address spaces */
+static void x64e_flush_page_saved(CPUState *cpu, target_ulong addr, uint16_t idxmap)
+{
+    X64ePcidState *st = cpu->uc->x64e_pcid;
+    int i, k, v;
+
+    if (!st) {
+        return;
+    }
+
+    for (i = 0; i < X64E_SLOTS; i++) {
+        X64ePcidSlot *s = &st->s[i];
+        unsigned int h, h0;
+
+        if (i == st->cur || !s->valid || s->gen != st->gen) {
+            continue;
+        }
+
+        for (k = 0; k < NB_MMU_MODES; k++) {
+            CPUTLBEntry *e;
+
+            if (!((idxmap >> k) & 1)) {
+                continue;
+            }
+
+            if ((addr & s->d[k].large_page_mask) == s->d[k].large_page_addr) {
+                s->gen = 0;                 /* whole address space stale */
+                break;
+            }
+
+            e = &s->f[k].table[(addr >> TARGET_PAGE_BITS) &
+                               (s->f[k].mask >> CPU_TLB_ENTRY_BITS)];
+            if (tlb_hit_page_anyprot(cpu->uc, e, addr & TARGET_PAGE_MASK)) {
+                memset(e, -1, sizeof(*e));
+                s->d[k].n_used_entries--;
+            }
+
+            for (v = 0; v < CPU_VTLB_SIZE; v++) {
+                if (tlb_hit_page_anyprot(cpu->uc, &s->d[k].vtable[v], addr & TARGET_PAGE_MASK)) {
+                    memset(&s->d[k].vtable[v], -1, sizeof(CPUTLBEntry));
+                }
+            }
+        }
+
+        h0 = tb_jmp_cache_hash_page(cpu->uc, addr - TARGET_PAGE_SIZE);
+        for (h = 0; h < TB_JMP_PAGE_SIZE; h++) {
+            s->jc[h0 + h] = NULL;
+        }
+        h0 = tb_jmp_cache_hash_page(cpu->uc, addr);
+        for (h = 0; h < TB_JMP_PAGE_SIZE; h++) {
+            s->jc[h0 + h] = NULL;
+        }
+    }
+}
+
+void x64e_jc_remove(CPUState *cpu, unsigned int h, struct TranslationBlock *tb)
+{
+    X64ePcidState *st = cpu->uc->x64e_pcid;
+    int i;
+
+    if (st) {
+        for (i = 0; i < X64E_SLOTS; i++) {
+            if (st->s[i].jc && st->s[i].jc[h] == tb) {
+                st->s[i].jc[h] = NULL;
+            }
+        }
+    }
+}
+
+void x64e_jc_clear_all(CPUState *cpu)
+{
+    X64ePcidState *st = cpu->uc->x64e_pcid;
+    int i;
+
+    if (st) {
+        for (i = 0; i < X64E_SLOTS; i++) {
+            if (st->s[i].jc && X64E_JC_FLAGS(st->s[i].jc)) {
+                memset(st->s[i].jc, 0, sizeof(struct TranslationBlock *) * (TB_JMP_CACHE_SIZE + 1));
+            }
+        }
+    }
+}
+
