 /* vim: set ts=4 sts=4 sw=4 et:  */
+
+UNICORN_EXPORT
+int uc_x86_set_irq_handler(struct uc_struct *uc, int (*ack)(void *opaque), void *opaque)
+{
+    uc->x86_irq_ack = ack;
+    uc->x86_irq_opaque = opaque;
+    return 0;
+}
+
+UNICORN_EXPORT
+int uc_x86_set_irq_line(struct uc_struct *uc, int level)
+{
+    CPUState *cs = uc->cpu;
+    if (level) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+    return 0;
+}
+
+UNICORN_EXPORT
+uint64_t uc_x86_get_pc64(struct uc_struct *uc)
+{
+    return ((CPUX86State *)uc->cpu->env_ptr)->eip;
+}
+
+UNICORN_EXPORT
+int uc_x86_is_halted(struct uc_struct *uc)
+{
+    return uc->cpu->halted;
+}
+
+/* out: 0..15 GPRs, 16 rip, 17 rflags, 18 cr0, 19 cr2, 20 cr3, 21 cr4, 22 efer */
+UNICORN_EXPORT
+void uc_x86_get_state64(struct uc_struct *uc, uint64_t *out)
+{
+    CPUX86State *env = (CPUX86State *)uc->cpu->env_ptr;
+    int i;
+
+    for (i = 0; i < 16; i++) {
+        out[i] = env->regs[i];
+    }
+    out[16] = env->eip;
+    out[17] = cpu_compute_eflags(env);
+    out[18] = env->cr[0];
+    out[19] = env->cr[2];
+    out[20] = env->cr[3];
+    out[21] = env->cr[4];
+    out[22] = env->efer;
+}
+
+UNICORN_EXPORT
+int uc_x86_set_system_mode(struct uc_struct *uc, int on)
+{
+    uc->x86_system_mode = on != 0;
+    return 0;
+}
+
+UNICORN_EXPORT
+int uc_x86_reset_requested(struct uc_struct *uc)
+{
+    int r = uc->reset_requested;
+    uc->reset_requested = false;
+    return r;
+}
+
+/* x64 engine: force an exit to the CPU loop at the next TB boundary */
+UNICORN_EXPORT
+void uc_x86_kick(struct uc_struct *uc)
+{
+    cpu_exit(uc->cpu);
+}
