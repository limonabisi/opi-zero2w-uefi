+
+/*
+ * ===================================================================
+ * x64 engine: shadow MMU - direct guest memory access (Captive-style)
+ * ===================================================================
+ *
+ * The firmware runs at EL1 while the x86 machine runs (see the engine's
+ * x64e_el.c), which leaves TTBR1_EL1 - the upper half of the AArch64
+ * address space - free. Guest virtual addresses are folded into it:
+ *
+ *     host VA = guest VA | 0xffff000000000000
+ *
+ * (x86-64 user addresses land in 0xffff0000_00000000.., kernel addresses
+ * are already 0xffff8000_00000000..), and the TCG backend turns every
+ * guest load/store of a long-mode TB into "orr x3, addr, #fold; ldr/str
+ * [x3]": no software TLB lookup at all. TTBR1 points to shadow page
+ * tables built on demand from the guest's page tables:
+ *
+ *  - a translation / permission fault on such an access lands in
+ *    uc_x64e_dabt(): the guest page tables are walked (setting A/D bits),
+ *    and the page is mapped (read-only unless the guest wrote it, and never
+ *    writable while translated code lives in it); the access is retried;
+ *  - if the guest itself would fault, or the page is not RAM, or it holds
+ *    code and is written, the faulting instruction is re-executed through
+ *    the ordinary softmmu path (a one-instruction TB, CF_X64E_SLOW), which
+ *    raises the #PF / does the I/O / invalidates the code precisely;
+ *  - every guest TLB invalidation the softmmu sees (CR3 without PCID
+ *    no-flush, INVLPG, CR4 changes) drops the matching shadow entries.
+ *
+ * One shadow tree per address space (PCID slot), with its own ASID. User
+ * and kernel share it: user pages are mapped EL0-accessible, and the
+ * accesses of user-mode TBs are emitted as LDTR/STTR, which the MMU checks
+ * with EL0 permissions - so the x86 U/S bit is enforced by hardware and no
+ * TTBR1 switch is needed on system calls and interrupts. (SMAP is not
+ * offered to the guest, so the kernel has a single MMU mode.)
+ */
+#if defined(TARGET_X86_64) && defined(__aarch64__)
+#define X64E_SHADOW_POSSIBLE 1
+#endif
+
+#define X64E_ROOTS        X64E_SLOTS        /* one tree per address space */
+#define X64E_FOLD         0xffff000000000000ULL
+/*
+ * The x86 upper half (the kernel) is the same in every address space as
+ * long as its pages are global: its shadow tables are built once, in a
+ * pseudo-tree, and every address space's tree links to them. A CR3 write
+ * then only drops the lower half, exactly what it flushes on a real CPU.
+ * The first non-global page seen in the upper half turns sharing off
+ * (until the next full flush).
+ */
+#define X64E_KKEY         X64E_ROOTS
+#define X64E_RMAP_REFS    3
+#define X64E_RMAP_MANY    1ULL          /* ref[0]; ref[1] = the epoch it was set in */
+#define X64E_PA_MASK      0x0000fffffffff000ULL
+
+/*
+ * Reverse map: for every RAM page, the shadow PTEs that map it writable,
+ * so that write access can be taken away when the page gets translated
+ * code. Up to X64E_RMAP_REFS references per page ((va | tree), the low
+ * bits of a page address are free); a page with more is marked "many" and
+ * protecting it drops all trees. References are not removed when a tree
+ * goes away: a stale one is harmless (at worst an unrelated mapping loses
+ * write access and gets it back at its next write) and is replaced when
+ * its slot is wanted. Dropping all trees starts a new epoch, which voids
+ * the "many" marks without touching the map.
+ */
+typedef struct X64eRmap {
+    uint64_t ref[X64E_RMAP_REFS];
+} X64eRmap;
+
+/* software bits of shadow table descriptors: the table maps (part of) a
+   guest 2 MB / 1 GB page, so an INVLPG anywhere in it drops all of it */
+#define X64E_SW_2M  (1ULL << 55)
+#define X64E_SW_1G  (1ULL << 56)
+
+typedef struct X64eShadow {
+    bool on;
+    uint8_t *pool;
+    uint32_t npages;
+    uint32_t *free;
+    uint32_t nfree;
+    uint64_t *root[X64E_ROOTS + 1];             /* [X64E_KKEY]: the shared upper half */
+    uint32_t gen[X64E_ROOTS + 1];
+    bool kshare;                                /* guest-global upper half shared by all trees */
+    uint64_t kfills, kflips;
+    int cur;
+    uint64_t ttbr0;
+    unsigned t0sz;
+    uint64_t attr_blk, attr_val;
+    X64eRmap *rmap;
+    uint64_t rmap_pages;    /* pages the reverse map covers */
+    uint64_t rmap_epoch;
+    uint64_t fills, slows, wprot, drops;
+    uint64_t slow_fault, slow_mmio, slow_code, large_inv;
+} X64eShadow;
+
+bool x86_x64e_probe(CPUState *cs, vaddr addr, MMUAccessType access_type, int mmu_idx);
+extern target_ulong x64e_probe_page_size;
+extern bool x64e_probe_user;
+extern bool x64e_probe_global;
+bool x64e_page_has_code(struct uc_struct *uc, ram_addr_t ram);
+
+bool x64e_shadow_enabled(struct uc_struct *uc)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+
+    return sh && sh->on;
+}
+
+#ifdef X64E_SHADOW_POSSIBLE
+
+static inline void x64e_tlbi_va_asid(uint64_t va, unsigned asid)
+{
+    uint64_t arg = ((va >> 12) & 0xfffffffffffULL) | ((uint64_t)asid << 48);
+
+    __asm__ volatile ("dsb ishst; tlbi vae1, %0; dsb nsh; isb" :: "r" (arg) : "memory");
+}
+
+static inline void x64e_tlbi_va_all(uint64_t va)
+{
+    uint64_t arg = (va >> 12) & 0xfffffffffffULL;
+
+    __asm__ volatile ("dsb ishst; tlbi vaae1, %0; dsb nsh; isb" :: "r" (arg) : "memory");
+}
+
+static inline void x64e_tlbi_asid(unsigned asid)
+{
+    uint64_t arg = (uint64_t)asid << 48;
+
+    __asm__ volatile ("dsb ishst; tlbi aside1, %0; dsb nsh; isb" :: "r" (arg) : "memory");
+}
+
+static inline void x64e_tlbi_all(void)
+{
+    __asm__ volatile ("tlbi vmalle1; dsb nsh; isb" ::: "memory");
+}
+
+static inline void x64e_set_ttbr1(uint64_t *root, unsigned asid)
+{
+    uint64_t v = ((uint64_t)(uintptr_t)root & X64E_PA_MASK) | ((uint64_t)asid << 48);
+
+    __asm__ volatile ("dsb ishst; msr ttbr1_el1, %0; isb" :: "r" (v) : "memory");
+}
+
+static uint64_t *x64e_alloc_table(X64eShadow *sh)
+{
+    uint64_t *t;
+
+    if (sh->nfree == 0) {
+        return NULL;
+    }
+    t = (uint64_t *)(sh->pool + (size_t)sh->free[--sh->nfree] * 4096);
+    memset(t, 0, 4096);
+    return t;
+}
+
+static void x64e_free_table(X64eShadow *sh, uint64_t *t, int level)
+{
+    int i;
+
+    if (level < 3) {
+        for (i = 0; i < 512; i++) {
+            if ((t[i] & 3) == 3) {
+                x64e_free_table(sh, (uint64_t *)(uintptr_t)(t[i] & X64E_PA_MASK), level + 1);
+            }
+        }
+    }
+    sh->free[sh->nfree++] = (uint32_t)(((uint8_t *)t - sh->pool) / 4096);
+}
+
+/* a new tree: with sharing on, its upper half is the shared one */
+static uint64_t *x64e_new_root(X64eShadow *sh)
+{
+    uint64_t *t = x64e_alloc_table(sh);
+
+    if (t && sh->kshare && sh->root[X64E_KKEY]) {
+        memcpy(t + 256, sh->root[X64E_KKEY] + 256, 256 * sizeof(uint64_t));
+    }
+    return t;
+}
+
+static void x64e_drop_root(X64eShadow *sh, int key)
+{
+    uint64_t *t = sh->root[key];
+    int i;
+
+    if (!t) {
+        return;
+    }
+    if (key != X64E_KKEY && sh->kshare) {
+        /* the upper half belongs to the shared tree */
+        for (i = 0; i < 256; i++) {
+            if ((t[i] & 3) == 3) {
+                x64e_free_table(sh, (uint64_t *)(uintptr_t)(t[i] & X64E_PA_MASK), 1);
+            }
+        }
+        sh->free[sh->nfree++] = (uint32_t)(((uint8_t *)t - sh->pool) / 4096);
+    } else {
+        x64e_free_table(sh, t, 0);
+    }
+    sh->root[key] = NULL;
+    sh->gen[key]++;
+    sh->drops++;
+    if (key == X64E_KKEY) {
+        /* nothing may link to the freed tables */
+        for (i = 0; i < X64E_ROOTS; i++) {
+            if (sh->root[i]) {
+                memset(sh->root[i] + 256, 0, 256 * sizeof(uint64_t));
+            }
+        }
+        x64e_tlbi_all();
+        return;
+    }
+    x64e_tlbi_asid(key + 1);
+    if (sh->cur == key) {
+        /* never leave TTBR1 on freed tables */
+        sh->root[key] = x64e_new_root(sh);
+        x64e_set_ttbr1(sh->root[key], key + 1);
+    }
+}
+
+static void x64e_rmap_reset(X64eShadow *sh)
+{
+    sh->rmap_epoch++;
+}
+
+static void x64e_drop_all(X64eShadow *sh)
+{
+    int k;
+
+    x64e_drop_root(sh, X64E_KKEY);              /* first: unlinks it everywhere */
+    for (k = 0; k < X64E_ROOTS; k++) {
+        x64e_drop_root(sh, k);
+    }
+    x64e_rmap_reset(sh);
+    x64e_tlbi_all();
+}
+
+static uint64_t *x64e_pte_mark(X64eShadow *sh, int key, uint64_t va, bool create, uint64_t mark1, uint64_t mark2)
+{
+    uint64_t *t = sh->root[key];
+    int level;
+
+    if (!t) {
+        return NULL;
+    }
+    for (level = 0; level < 3; level++) {
+        uint64_t *e = &t[(va >> (39 - 9 * level)) & 511];
+
+        if ((*e & 3) != 3) {
+            uint64_t *n;
+
+            if (!create || !(n = x64e_alloc_table(sh))) {
+                return NULL;
+            }
+            *e = ((uint64_t)(uintptr_t)n & X64E_PA_MASK) | 3;
+        }
+        if (level == 1) {
+            *e |= mark1;
+        } else if (level == 2) {
+            *e |= mark2;
+        }
+        t = (uint64_t *)(uintptr_t)(*e & X64E_PA_MASK);
+    }
+    return &t[(va >> 12) & 511];
+}
+
+static uint64_t *x64e_pte(X64eShadow *sh, int key, uint64_t va, bool create)
+{
+    return x64e_pte_mark(sh, key, va, create, 0, 0);
+}
+
+/* memory attribute index the firmware's identity map uses for a PA */
+static uint64_t x64e_attr(X64eShadow *sh, uint64_t pa)
+{
+    unsigned bits = 64 - sh->t0sz;
+    int level = bits > 39 ? 0 : bits > 30 ? 1 : bits > 21 ? 2 : 3;
+    uint64_t *t = (uint64_t *)(uintptr_t)(sh->ttbr0 & X64E_PA_MASK);
+
+    if ((pa >> 21) == sh->attr_blk) {
+        return sh->attr_val;
+    }
+    for (;;) {
+        unsigned shift = 39 - 9 * level;
+        uint64_t d = t[(pa >> shift) & 511];
+
+        if (level < 3 && (d & 3) == 3) {
+            t = (uint64_t *)(uintptr_t)(d & X64E_PA_MASK);
+            level++;
+            continue;
+        }
+        if ((level < 3 && (d & 3) == 1) || (level == 3 && (d & 3) == 3)) {
+            sh->attr_blk = pa >> 21;
+            sh->attr_val = (d >> 2) & 7;
+            return sh->attr_val;
+        }
+        return 0;
+    }
+}
+
+/* does this reference still name a writable shadow PTE? */
+static bool x64e_rmap_live(X64eShadow *sh, uint64_t ref)
+{
+    uint64_t *pte = x64e_pte(sh, (int)(ref & 15), ref & ~0xfffULL, false);
+
+    return pte && (*pte & 3) == 3 && !(*pte & (2ULL << 6));
+}
+
+static void x64e_rmap_add(X64eShadow *sh, uint64_t page, int key, uint64_t va, uint64_t pa)
+{
+    uint64_t ref = (va & ~0xfffULL) | (uint64_t)key;
+    X64eRmap *e;
+    int i, slot = -1;
+
+    if (page >= sh->rmap_pages) {
+        uint64_t n = (page + 0x4000) & ~0x3fffULL;
+
+        sh->rmap = g_realloc(sh->rmap, n * sizeof(X64eRmap));
+        memset(sh->rmap + sh->rmap_pages, 0, (n - sh->rmap_pages) * sizeof(X64eRmap));
+        sh->rmap_pages = n;
+    }
+    e = &sh->rmap[page];
+    if (e->ref[0] == X64E_RMAP_MANY) {
+        if (e->ref[1] == sh->rmap_epoch) {
+            return;
+        }
+        memset(e, 0, sizeof(*e));               /* a mark from before the last drop */
+    }
+    for (i = 0; i < X64E_RMAP_REFS; i++) {
+        if (e->ref[i] == ref) {
+            return;
+        }
+        if (e->ref[i] == 0 && slot < 0) {
+            slot = i;
+        }
+    }
+    if (slot < 0) {
+        /* full: take the place of a reference that went stale */
+        for (i = 0; i < X64E_RMAP_REFS; i++) {
+            if (!x64e_rmap_live(sh, e->ref[i])) {
+                slot = i;
+                break;
+            }
+        }
+    }
+    if (slot < 0) {
+        e->ref[0] = X64E_RMAP_MANY;
+        e->ref[1] = sh->rmap_epoch;
+        return;
+    }
+    e->ref[slot] = ref;
+}
+
+/* a page got translated code: no shadow mapping may write it any more */
+static void x64e_shadow_protect(struct uc_struct *uc, ram_addr_t ram)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+    uint64_t page = ram >> TARGET_PAGE_BITS;
+    X64eRmap *e;
+    int i;
+
+    if (!sh || !sh->on || page >= sh->rmap_pages) {
+        return;
+    }
+    e = &sh->rmap[page];
+    if (e->ref[0] == X64E_RMAP_MANY) {
+        bool live = e->ref[1] == sh->rmap_epoch;
+
+        memset(e, 0, sizeof(*e));
+        if (live) {
+            /* mapped writable in more places than are remembered */
+            x64e_drop_all(sh);
+            sh->wprot++;
+        }
+        return;
+    }
+    for (i = 0; i < X64E_RMAP_REFS; i++) {
+        uint64_t ref = e->ref[i], va = ref & ~0xfffULL, *pte;
+        int key = (int)(ref & 15);
+
+        if (ref == 0) {
+            continue;
+        }
+        e->ref[i] = 0;
+        pte = x64e_pte(sh, key, va, false);
+        if (pte && (*pte & 3) == 3 && !(*pte & (2ULL << 6))) {
+            *pte |= (2ULL << 6);                /* read-only */
+            if (key == X64E_KKEY) {
+                x64e_tlbi_va_all(va);
+            } else {
+                x64e_tlbi_va_asid(va, key + 1);
+            }
+            sh->wprot++;
+        }
+    }
+}
+
+static int x64e_cur_slot(struct uc_struct *uc)
+{
+    X64ePcidState *st = uc->x64e_pcid;
+
+    return st ? st->cur : 0;
+}
+
+/* before running a TB: TTBR1 must hold the shadow tree of its MMU mode */
+void x64e_shadow_activate(CPUState *cpu, TranslationBlock *tb)
+{
+    X64eShadow *sh = cpu->uc->x64e_shadow;
+    int key;
+
+    if (!sh || !sh->on) {
+        return;
+    }
+    key = x64e_cur_slot(cpu->uc);
+    if (key == sh->cur) {
+        return;
+    }
+    if (!sh->root[key] && !(sh->root[key] = x64e_new_root(sh))) {
+        x64e_drop_all(sh);
+        sh->root[key] = x64e_new_root(sh);
+    }
+    sh->cur = key;
+    x64e_set_ttbr1(sh->root[key], key + 1);
+}
+
+/* guest TLB invalidations, from the softmmu flush paths */
+static void x64e_shadow_flush_all(struct uc_struct *uc)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+
+    if (sh && sh->on) {
+        x64e_drop_all(sh);
+        sh->kshare = true;                      /* a clean start: share again */
+    }
+}
+
+static void x64e_shadow_flush_slot(struct uc_struct *uc, int slot)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+
+    if (sh && sh->on) {
+        x64e_drop_root(sh, slot);
+    }
+}
+
+static void x64e_shadow_flush_page(struct uc_struct *uc, target_ulong addr)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+    uint64_t va = (uint64_t)addr | X64E_FOLD;
+    int k;
+
+    if (!sh || !sh->on) {
+        return;
+    }
+    for (k = 0; k <= X64E_ROOTS; k++) {
+        uint64_t *t = sh->root[k], *e1, *e2, *l2, *l3;
+
+        if (sh->kshare && (va & (1ULL << 47)) && k != X64E_KKEY) {
+            continue;                           /* shared: once, through its own tree */
+        }
+        if (!t || (t[(va >> 39) & 511] & 3) != 3) {
+            continue;
+        }
+        t = (uint64_t *)(uintptr_t)(t[(va >> 39) & 511] & X64E_PA_MASK);
+        e1 = &t[(va >> 30) & 511];
+        if ((*e1 & 3) != 3) {
+            continue;
+        }
+        l2 = (uint64_t *)(uintptr_t)(*e1 & X64E_PA_MASK);
+        if (*e1 & X64E_SW_1G) {                 /* a guest 1 GB page: all of it */
+            x64e_free_table(sh, l2, 2);
+            *e1 = 0;
+            if (k == X64E_KKEY) {
+                x64e_tlbi_all();
+            } else {
+                x64e_tlbi_asid(k + 1);
+            }
+            sh->large_inv++;
+            continue;
+        }
+        e2 = &l2[(va >> 21) & 511];
+        if ((*e2 & 3) != 3) {
+            continue;
+        }
+        l3 = (uint64_t *)(uintptr_t)(*e2 & X64E_PA_MASK);
+        if (*e2 & X64E_SW_2M) {                 /* a guest 2 MB page: all of it */
+            x64e_free_table(sh, l3, 3);
+            *e2 = 0;
+            if (k == X64E_KKEY) {
+                x64e_tlbi_all();
+            } else {
+                x64e_tlbi_asid(k + 1);
+            }
+            sh->large_inv++;
+            continue;
+        }
+        l3[(va >> 12) & 511] = 0;
+    }
+    x64e_tlbi_va_all(va);
+}
+
+static int x64e_fill(CPUState *cpu, X64eShadow *sh, uint64_t gva, bool is_write, uint64_t host_pc)
+{
+    CPUArchState *env = cpu->env_ptr;
+    struct uc_struct *uc = cpu->uc;
+    int key = sh->cur, idx = cpu_mmu_index(env, false);
+    uint64_t va = gva | X64E_FOLD, page = gva & TARGET_PAGE_MASK;
+    uintptr_t index;
+    CPUTLBEntry *e;
+    target_ulong rd, wr, ps;
+    uint64_t host, ram, old, pte, *p, m1, m2;
+    bool can_w, code, user, shared = false;
+
+    if (key < 0 || !x86_x64e_probe(cpu, gva, is_write ? MMU_DATA_STORE : MMU_DATA_LOAD, idx)) {
+        sh->slow_fault++;
+        return 1;                               /* guest fault: precise #PF */
+    }
+    ps = x64e_probe_page_size;
+    user = x64e_probe_user;
+    if (gva & (1ULL << 47)) {
+        if (sh->kshare && !x64e_probe_global) {
+            /* a non-global page in the upper half: every tree on its own */
+            x64e_drop_all(sh);
+            sh->kshare = false;
+            sh->kflips++;
+        }
+        shared = sh->kshare;
+    }
+    index = tlb_index(env, idx, gva);
+    e = tlb_entry(env, idx, gva);
+    rd = e->addr_read;
+    wr = tlb_addr_write(e);
+    if (!tlb_hit_page(uc, rd, page) || (rd & TLB_MMIO)) {
+        sh->slow_mmio++;
+        return 1;                               /* not plain RAM */
+    }
+    host = page + e->addend;
+    ram = (page + env_tlb(env)->d[idx].iotlb[index].addr) & TARGET_PAGE_MASK;
+    can_w = tlb_hit_page(uc, wr, page) && !(wr & (TLB_MMIO | TLB_DISCARD_WRITE));
+    code = x64e_page_has_code(uc, ram);
+
+    if (is_write && code) {
+        /*
+         * A write to a page that holds translated code: drop all of that
+         * code at once (it is retranslated if run again), unless the
+         * running TB itself is on the page - then be precise.
+         */
+        TranslationBlock *tb = tcg_tb_lookup(uc->tcg_ctx, host_pc);
+
+        if (tb && (tb->page_addr[0] == ram || tb->page_addr[1] == ram)) {
+            sh->slow_code++;
+            return 1;
+        }
+        tb_invalidate_phys_range(uc, ram, ram + TARGET_PAGE_SIZE);
+        code = x64e_page_has_code(uc, ram);
+        if (code) {
+            sh->slow_code++;
+            return 1;
+        }
+    }
+    if (is_write && !can_w) {
+        sh->slow_code++;
+        return 1;
+    }
+    /* user pages: accessible from EL0 (AP[1]); a kernel write to a read-only
+       user page with CR0.WP clear cannot be expressed: softmmu */
+    if (is_write && user && !(env->cr[0] & CR0_WP_MASK) && idx != MMU_USER_IDX) {
+        sh->slow_code++;
+        return 1;
+    }
+
+    pte = (host & X64E_PA_MASK) | 3 | (x64e_attr(sh, host) << 2) | (3ULL << 8) |
+          (1ULL << 10) | (1ULL << 11) | (1ULL << 53) | (1ULL << 54);
+    if (user) {
+        pte |= 1ULL << 6;                       /* EL0 access */
+    }
+    if (!(can_w && !code)) {
+        pte |= 2ULL << 6;                       /* read-only */
+    }
+
+    m1 = ps >= (1ULL << 30) ? X64E_SW_1G : 0;
+    m2 = ps >= (1ULL << 21) && ps < (1ULL << 30) ? X64E_SW_2M : 0;
+    if (shared) {
+        int l0 = (va >> 39) & 511, k;
+
+        pte &= ~(1ULL << 11);                   /* global: every ASID */
+        key = X64E_KKEY;
+        if (!sh->root[key]) {
+            sh->root[key] = x64e_alloc_table(sh);
+        }
+        p = x64e_pte_mark(sh, key, va, true, m1, m2);
+        if (!p) {
+            x64e_drop_all(sh);
+            sh->root[key] = x64e_alloc_table(sh);
+            p = x64e_pte_mark(sh, key, va, true, m1, m2);
+        }
+        if (!p) {
+            return 1;
+        }
+        /* every tree sees the shared tables */
+        for (k = 0; k < X64E_ROOTS; k++) {
+            if (sh->root[k] && sh->root[k][l0] != sh->root[key][l0]) {
+                sh->root[k][l0] = sh->root[key][l0];
+            }
+        }
+        sh->kfills++;
+    } else {
+        p = x64e_pte_mark(sh, key, va, true, m1, m2);
+        if (!p) {
+            x64e_drop_all(sh);
+            p = x64e_pte_mark(sh, key, va, true, m1, m2);
+        }
+        if (!p) {
+            return 1;
+        }
+    }
+    old = *p;
+    *p = pte;
+    if ((old & 3) == 3) {
+        if (shared) {
+            x64e_tlbi_va_all(va);
+        } else {
+            x64e_tlbi_va_asid(va, key + 1);
+        }
+    } else {
+        __asm__ volatile ("dsb ishst; isb" ::: "memory");
+    }
+    if (!(pte & (2ULL << 6))) {
+        x64e_rmap_add(sh, ram >> TARGET_PAGE_BITS, key, va, host & X64E_PA_MASK);
+    }
+    sh->fills++;
+    return 0;
+}
