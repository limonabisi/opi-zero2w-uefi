+    case MO_UW: insn = 0x78400800; break;
+    case MO_SW: insn = bswap ? 0x78400800 : (ext ? 0x78800800 : 0x78c00800); break;
+    case MO_UL: insn = 0xb8400800; break;
+    case MO_SL: insn = bswap ? 0xb8400800 : 0xb8800800; break;
+    case MO_Q:  insn = 0xf8400800; break;
+    default:
+        tcg_abort();
+    }
+    tcg_out32(s, insn | (TCG_REG_X3 << 5) | data_r);
+    if (bswap) {
+        switch (memop & MO_SIZE) {
+        case MO_16:
+            tcg_out_rev16(s, data_r, data_r);
+            if (memop & MO_SIGN) {
+                tcg_out_sxt(s, ext, MO_16, data_r, data_r);
+            }
+            break;
+        case MO_32:
+            tcg_out_rev32(s, data_r, data_r);
+            if (memop & MO_SIGN) {
+                tcg_out_sxt(s, TCG_TYPE_I64, MO_32, data_r, data_r);
+            }
+            break;
+        case MO_64:
+            tcg_out_rev64(s, data_r, data_r);
+            break;
+        default:
+            break;
+        }
+    }
+}
