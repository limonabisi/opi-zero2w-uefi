+
+/*
+ * x64 engine: REP MOVS / REP STOS in bulk.
+ *
+ * The translator runs these one element per loop; kernels and C libraries
+ * use them for every large copy and fill (page clearing, file data, fork).
+ * These helpers do as many whole elements as fit in the current pages with
+ * the host's memcpy / memset, a page pair at a time, and leave RSI / RDI /
+ * RCX exactly as the instruction would after that many iterations, so a
+ * fault or an interrupt in between is as precise as before. Whatever they
+ * do not take (DF set, a device page, an element across a page boundary,
+ * overlapping forward copies) is left to the translator's loop.
+ */
+#ifdef TARGET_X86_64
+#define X64E_REP_MAX  (4ULL << 20)          /* bytes per call: bounds interrupt latency */
+
+static inline uint64_t x64e_rep_chunk(CPUX86State *env, uint64_t a, uint64_t b, uint32_t ot)
+{
+    uint64_t n, room;
+
+    n = env->regs[R_ECX] > (X64E_REP_MAX >> ot) ? X64E_REP_MAX : env->regs[R_ECX] << ot;
+    room = TARGET_PAGE_SIZE - (a & ~TARGET_PAGE_MASK);
+    if (n > room) {
+        n = room;
+    }
+    room = TARGET_PAGE_SIZE - (b & ~TARGET_PAGE_MASK);
+    if (n > room) {
+        n = room;
+    }
+    return n & ~((1ULL << ot) - 1);
+}
+
+void helper_x64e_rep_movs(CPUX86State *env, uint32_t ot)
+{
+    uintptr_t ra = GETPC();
+    int idx = cpu_mmu_index(env, false);
+    uint64_t done = 0;
+
+    if (env->df != 1) {
+        return;
+    }
+    while (env->regs[R_ECX] != 0 && done < X64E_REP_MAX) {
+        uint64_t src = env->regs[R_ESI], dst = env->regs[R_EDI];
+        uint64_t n = x64e_rep_chunk(env, src, dst, ot);
+        uint8_t *hs, *hd;
+
+        if (n == 0) {
+            return;
+        }
+        hs = probe_access(env, src, n, MMU_DATA_LOAD, idx, ra);
+        hd = probe_access(env, dst, n, MMU_DATA_STORE, idx, ra);
+        if (!hs || !hd) {
+            return;
+        }
+        if (hd > hs && hd < hs + n) {
+            /* forward copy onto its own source: only up to the overlap */
+            n = (uint64_t)(hd - hs) & ~((1ULL << ot) - 1);
+            if (n == 0) {
+                return;
+            }
+        }
+        memmove(hd, hs, n);
+        env->regs[R_ESI] = src + n;
+        env->regs[R_EDI] = dst + n;
+        env->regs[R_ECX] -= n >> ot;
+        done += n;
+    }
+    env->uc->x64e_bulk += done;
+}
+
+void helper_x64e_rep_stos(CPUX86State *env, uint32_t ot)
+{
+    uintptr_t ra = GETPC();
+    int idx = cpu_mmu_index(env, false);
+    uint64_t done = 0, v = env->regs[R_EAX], i;
+
+    if (env->df != 1) {
+        return;
+    }
+    while (env->regs[R_ECX] != 0 && done < X64E_REP_MAX) {
+        uint64_t dst = env->regs[R_EDI];
+        uint64_t n = x64e_rep_chunk(env, dst, dst, ot);
+        uint8_t *hd;
+
+        if (n == 0) {
+            return;
+        }
+        hd = probe_access(env, dst, n, MMU_DATA_STORE, idx, ra);
+        if (!hd) {
+            return;
+        }
+        switch (ot) {
+        case 0:
+            memset(hd, (uint8_t)v, n);
+            break;
+        case 1:
+            for (i = 0; i < n; i += 2) {
+                uint16_t w = (uint16_t)v;
+                memcpy(hd + i, &w, 2);
+            }
+            break;
+        case 2:
+            for (i = 0; i < n; i += 4) {
+                uint32_t w = (uint32_t)v;
+                memcpy(hd + i, &w, 4);
+            }
+            break;
+        default:
+            if (v == 0) {
+                memset(hd, 0, n);
+            } else {
+                for (i = 0; i < n; i += 8) {
+                    memcpy(hd + i, &v, 8);
+                }
+            }
+            break;
+        }
+        env->regs[R_EDI] = dst + n;
+        env->regs[R_ECX] -= n >> ot;
+        done += n;
+    }
+    env->uc->x64e_bulk += done;
+}
+#else
+void helper_x64e_rep_movs(CPUX86State *env, uint32_t ot) { }
+void helper_x64e_rep_stos(CPUX86State *env, uint32_t ot) { }
+#endif
