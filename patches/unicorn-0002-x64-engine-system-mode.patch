+
+UNICORN_EXPORT
+int uc_x86_set_irq_line(struct uc_struct *uc, int level)
+{
+    CPUState *cs = uc->cpu;
+    if (level) {
+        cpu_interrupt(cs, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_HARD);
+    }
+    return 0;
