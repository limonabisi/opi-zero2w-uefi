+/* out: 0..15 GPRs, 16 rip, 17 rflags, 18 cr0, 19 cr2, 20 cr3, 21 cr4, 22 efer */
+UNICORN_EXPORT
+void uc_x86_get_state64(struct uc_struct *uc, uint64_t *out)
+{
+    CPUX86State *env = (CPUX86State *)uc->cpu->env_ptr;
+    int i;
+
+    for (i = 0; i < 16; i++) {
+        out[i] = env->regs[i];
+    }
+    out[16] = env->eip;
+    out[17] = cpu_compute_eflags(env);
+    out[18] = env->cr[0];
+    out[19] = env->cr[2];
+    out[20] = env->cr[3];
+    out[21] = env->cr[4];
+    out[22] = env->efer;
+}
+
+UNICORN_EXPORT
+int uc_x86_set_system_mode(struct uc_struct *uc, int on)
+{
+    uc->x86_system_mode = on != 0;
+    /* x64 engine: PCIDs let the guest keep TLBs across context switches;
+       on & 2 leaves them out (for comparisons). Applied in x86_reg_reset. */
+    uc->x64e_nopcid = (on & 2) != 0;
+    uc->x64e_nobulk = (on & 4) != 0;
+    uc->x64e_nokchain = (on & 8) != 0;
+    uc->x64e_nolookup = (on & 16) != 0;
+    if (uc->cpu) {
+        CPUArchState *env = uc->cpu->env_ptr;
+
+        if (on && !uc->x64e_nopcid) {
+            env->features[FEAT_1_ECX] |= CPUID_EXT_PCID;
+        } else {
+            env->features[FEAT_1_ECX] &= ~CPUID_EXT_PCID;
+        }
+        if (on && !uc->x64e_nobulk) {
+            /* REP MOVSB / STOSB are done natively (mem_helper.c): tell the guest they are fast */
+            env->features[FEAT_7_0_EBX] |= CPUID_7_0_EBX_ERMS;
+        }
+        if (on) {
+            env->features[FEAT_7_0_EBX] &= ~CPUID_7_0_EBX_SMAP;
+        }
+    }
+    return 0;
+}
+
+/* x64 engine: a device wrote guest RAM (DMA): drop code translated from it */
+UNICORN_EXPORT
+void uc_x86_invalidate_host(struct uc_struct *uc, void *host, size_t len)
+{
+    ram_addr_t ra;
+
+    if (!uc->cpu || len == 0) {
+        return;
+    }
+
+    ra = qemu_ram_addr_from_host(uc, host);
+    if (ra == RAM_ADDR_INVALID) {
+        return;
+    }
+
+    tb_invalidate_phys_range(uc, ra, ra + len);
+}
+
+UNICORN_EXPORT
+int uc_x86_reset_requested(struct uc_struct *uc)
+{
+    int r = uc->reset_requested;
+    uc->reset_requested = false;
+    return r;
+}
