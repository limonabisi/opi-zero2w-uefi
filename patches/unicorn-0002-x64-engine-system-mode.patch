+UNICORN_EXPORT
+int uc_x64e_shadow_init(struct uc_struct *uc, void *pool, size_t bytes)
+{
+    X64eShadow *sh;
+    uint64_t tcr, *r;
+    uint32_t i;
+
+    if (!uc->cpu || bytes < 64 * 4096) {
+        return -1;
+    }
+    sh = g_new0(X64eShadow, 1);
+    sh->pool = (uint8_t *)(((uintptr_t)pool + 4095) & ~(uintptr_t)4095);
+    sh->npages = (uint32_t)((bytes - ((uintptr_t)sh->pool - (uintptr_t)pool)) / 4096);
+    sh->free = g_new(uint32_t, sh->npages);
+    for (i = 0; i < sh->npages; i++) {
+        sh->free[i] = sh->npages - 1 - i;
+    }
+    sh->nfree = sh->npages;
+    sh->rmap = NULL;
+    sh->rmap_pages = 0;
+    sh->cur = -1;
+    sh->kshare = true;
+    sh->attr_blk = (uint64_t)-1;
+
+    __asm__ volatile ("mrs %0, ttbr0_el1" : "=r" (sh->ttbr0));
+    __asm__ volatile ("mrs %0, tcr_el1" : "=r" (tcr));
+    sh->t0sz = tcr & 63;
+
+    /* an empty tree first, then let TTBR1 walk: T1SZ 16, 4K, ASID from TTBR1 */
+    r = x64e_alloc_table(sh);
+    x64e_set_ttbr1(r, 0);
+    tcr &= ~((1ULL << 23) | (63ULL << 16) | (3ULL << 30));
+    tcr |= (16ULL << 16) | (2ULL << 30) | (1ULL << 22);
+    __asm__ volatile ("msr tcr_el1, %0; isb; tlbi vmalle1; dsb nsh; isb" :: "r" (tcr) : "memory");
+    x64e_free_table(sh, r, 3);
+
+    uc->x64e_shadow = sh;
+    sh->on = true;
+    tb_flush(uc->cpu);                          /* retranslate with direct accesses */
+    return 0;
+}
+
+UNICORN_EXPORT
+void uc_x64e_shadow_fini(struct uc_struct *uc)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+    uint64_t tcr;
+
+    if (!sh) {
+        return;
+    }
+    sh->on = false;
+    __asm__ volatile ("mrs %0, tcr_el1" : "=r" (tcr));
+    tcr |= 1ULL << 23;                          /* EPD1: no TTBR1 walks */
+    __asm__ volatile ("msr tcr_el1, %0; isb; tlbi vmalle1; dsb nsh; isb" :: "r" (tcr) : "memory");
+    tb_flush(uc->cpu);
+}
+
+/* data abort at EL1: 0 handled (retry), 1 re-execute via softmmu, -1 not ours */
+UNICORN_EXPORT
+int uc_x64e_dabt(struct uc_struct *uc, uint64_t far, uint64_t esr, uint64_t elr)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+    TCGContext *tcg_ctx = uc->tcg_ctx;
+    uint64_t gva;
+
+    if (!sh || !sh->on || ((esr >> 26) & 0x3f) != 0x25 || far < X64E_FOLD ||
+        elr < (uintptr_t)tcg_ctx->code_gen_buffer ||
+        elr >= (uintptr_t)tcg_ctx->code_gen_buffer + tcg_ctx->code_gen_buffer_size) {
+        return -1;
+    }
+    gva = (far & (1ULL << 47)) ? far : (far & 0x00007fffffffffffULL);
+    return x64e_fill(uc->cpu, sh, gva, (esr >> 6) & 1, elr) ? 1 : 0;
+}
+
+UNICORN_EXPORT
+void uc_x64e_slowpath(struct uc_struct *uc, uint64_t host_pc)
+{
+    X64eShadow *sh = uc->x64e_shadow;
+    CPUState *cpu = uc->cpu;
+
+    sh->slows++;
+    cpu_restore_state(cpu, host_pc + GETPC_ADJ, true);
+    cpu->cflags_next_tb = 1 | CF_X64E_SLOW;
+    cpu_loop_exit(cpu);
+}
+
+UNICORN_EXPORT
+void uc_x64e_shadow_stats(struct uc_struct *uc, uint64_t out[10])
+{
+    X64eShadow *sh = uc->x64e_shadow;
+
+    if (!sh) {
+        memset(out, 0, 10 * sizeof(uint64_t));
+        return;
+    }
+    out[6] = sh->slow_fault;
+    out[7] = sh->slow_mmio;
+    out[8] = sh->slow_code;
+    out[9] = sh->large_inv;
+    out[0] = sh->fills;
+    out[1] = sh->slows;
+    out[2] = sh->wprot;
+    out[3] = sh->drops;
+    out[4] = sh->npages - sh->nfree;
+    out[5] = sh->kfills;
+}
