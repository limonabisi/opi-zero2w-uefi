+    switch (memop & MO_SIZE) {
+    case MO_8:  insn = 0x38000800; break;
+    case MO_16: insn = 0x78000800; break;
+    case MO_32: insn = 0xb8000800; break;
+    case MO_64: insn = 0xf8000800; break;
+    default:
+        tcg_abort();
+    }
+    if (bswap && data_r != TCG_REG_XZR) {
+        switch (memop & MO_SIZE) {
+        case MO_16: tcg_out_rev16(s, TCG_REG_TMP, data_r); data_r = TCG_REG_TMP; break;
+        case MO_32: tcg_out_rev32(s, TCG_REG_TMP, data_r); data_r = TCG_REG_TMP; break;
+        case MO_64: tcg_out_rev64(s, TCG_REG_TMP, data_r); data_r = TCG_REG_TMP; break;
+        default: break;
+        }
+    }
+    tcg_out32(s, insn | (TCG_REG_X3 << 5) | data_r);
+}
