@@ -8,6 +8,18 @@
 
 #include "UsbRndis.h"
 
+//
+// RNDIS control interface: Microsoft's CDC-ACM/vendor form, the misc-class
+// form, and the wireless-controller form that Android phones (Linux
+// f_rndis) use for USB tethering.
+//
+#define IS_RNDIS_CONTROL(Desc) \
+  ((((Desc).InterfaceClass == USB_CDC_CLASS) && ((Desc).InterfaceSubClass == USB_CDC_ACM_SUBCLASS) && \
+    ((Desc).InterfaceProtocol == USB_VENDOR_PROTOCOL)) || \
+   (((Desc).InterfaceClass == USB_MISC_CLASS) && ((Desc).InterfaceSubClass == USB_RNDIS_SUBCLASS) && \
+    ((Desc).InterfaceProtocol == USB_RNDIS_ETHERNET_PROTOCOL)) || \
+   (((Desc).InterfaceClass == 0xE0) && ((Desc).InterfaceSubClass == 0x01) && ((Desc).InterfaceProtocol == 0x03)))
+
 EFI_DRIVER_BINDING_PROTOCOL  gUsbRndisDriverBinding = {
   UsbRndisDriverSupported,
   UsbRndisDriverStart,
@@ -40,12 +52,7 @@ IsSupportedDevice (
   }
 
   // Check specific device/RNDIS and CDC-DATA
-  if (((InterfaceDescriptor.InterfaceClass == USB_CDC_CLASS) &&
-       (InterfaceDescriptor.InterfaceSubClass == USB_CDC_ACM_SUBCLASS) &&
-       (InterfaceDescriptor.InterfaceProtocol == USB_VENDOR_PROTOCOL)) || \
-      ((InterfaceDescriptor.InterfaceClass == USB_MISC_CLASS) &&
-       (InterfaceDescriptor.InterfaceSubClass == USB_RNDIS_SUBCLASS) &&
-       (InterfaceDescriptor.InterfaceProtocol == USB_RNDIS_ETHERNET_PROTOCOL)) || \
+  if (IS_RNDIS_CONTROL (InterfaceDescriptor) || \
       ((InterfaceDescriptor.InterfaceClass == USB_CDC_DATA_CLASS) &&
        (InterfaceDescriptor.InterfaceSubClass == USB_CDC_DATA_SUBCLASS) &&
        (InterfaceDescriptor.InterfaceProtocol == USB_NO_CLASS_PROTOCOL))
@@ -79,13 +86,7 @@ IsRndisInterface (
   }
 
   // Check for specific device/RNDIS and CDC-DATA
-  if (((InterfaceDescriptor.InterfaceClass == USB_CDC_CLASS) &&
-       (InterfaceDescriptor.InterfaceSubClass == USB_CDC_ACM_SUBCLASS) &&
-       (InterfaceDescriptor.InterfaceProtocol == USB_VENDOR_PROTOCOL)) || \
-      ((InterfaceDescriptor.InterfaceClass == USB_MISC_CLASS) &&
-       (InterfaceDescriptor.InterfaceSubClass == USB_RNDIS_SUBCLASS) &&
-       (InterfaceDescriptor.InterfaceProtocol == USB_RNDIS_ETHERNET_PROTOCOL))
-      )
+  if (IS_RNDIS_CONTROL (InterfaceDescriptor))
   {
     return TRUE;
   }
@@ -188,9 +189,7 @@ IsUsbRndis (
   }
 
   // Check for Rndis
-  if ((InterfaceDescriptor.InterfaceClass == USB_CDC_CLASS) &&
-      (InterfaceDescriptor.InterfaceSubClass == USB_CDC_ACM_SUBCLASS) &&
-      (InterfaceDescriptor.InterfaceProtocol == USB_VENDOR_PROTOCOL))
+  if (IS_RNDIS_CONTROL (InterfaceDescriptor))
   {
     return TRUE;
   }
