index 64da8d7..8a72012 100644
--- a/MdeModulePkg/Bus/Usb/UsbBusDxe/UsbEnumer.c
+++ b/MdeModulePkg/Bus/Usb/UsbBusDxe/UsbEnumer.c
@@ -1140,6 +1140,9 @@ UsbHubEnumeration (
   @param  Context               The context to the event.
 
 **/
+STATIC UINT8  mRootIdle[8];
+STATIC UINT8  mRootRetry[8];
+
 VOID
 EFIAPI
 UsbRootHubEnumeration (
@@ -1147,9 +1150,10 @@ UsbRootHubEnumeration (
   IN VOID       *Context
   )
 {
-  USB_INTERFACE  *RootHub;
-  UINT8          Index;
-  USB_DEVICE     *Child;
+  USB_INTERFACE        *RootHub;
+  UINT8                Index;
+  USB_DEVICE           *Child;
+  EFI_USB_PORT_STATUS  PortState;
 
   RootHub = (USB_INTERFACE *)Context;
 
@@ -1161,5 +1165,32 @@ UsbRootHubEnumeration (
     }
 
     UsbEnumeratePort (RootHub, Index);
+
+    //
+    // OPi Zero 2W: if a device is connected but its enumeration failed
+    // (e.g. the root port reset timed out), no further change event will
+    // ever arrive.  Retry it a few times, once per second.
+    //
+    if (Index < ARRAY_SIZE (mRootRetry)) {
+      Child = UsbFindChild (RootHub, Index);
+      ZeroMem (&PortState, sizeof (PortState));
+      if (  (Child == NULL)
+         && !EFI_ERROR (RootHub->HubApi->GetPortStatus (RootHub, Index, &PortState))
+         && USB_BIT_IS_SET (PortState.PortStatus, USB_PORT_STAT_CONNECTION)
+         && !USB_BIT_IS_SET (PortState.PortStatus, USB_PORT_STAT_OWNER))
+      {
+        if ((mRootRetry[Index] < 5) && (++mRootIdle[Index] >= 10)) {
+          mRootIdle[Index] = 0;
+          mRootRetry[Index]++;
+          DEBUG ((DEBUG_WARN, "UsbRootHubEnumeration: port %d connected but not enumerated, retry %d\n", Index, mRootRetry[Index]));
+          UsbEnumerateNewDev (RootHub, Index, TRUE);
+        }
+      } else if (!USB_BIT_IS_SET (PortState.PortStatus, USB_PORT_STAT_CONNECTION)) {
+        mRootIdle[Index]  = 0;
+        mRootRetry[Index] = 0;
+      } else {
+        mRootIdle[Index] = 0;
+      }
+    }
   }
 }
