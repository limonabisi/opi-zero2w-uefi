diff --git a/MdeModulePkg/Bus/Usb/UsbNetwork/UsbRndis/UsbRndisFunction.c b/MdeModulePkg/Bus/Usb/UsbNetwork/UsbRndis/UsbRndisFunction.c
index 8723a82..27cde82 100644
--- a/MdeModulePkg/Bus/Usb/UsbNetwork/UsbRndis/UsbRndisFunction.c
+++ b/MdeModulePkg/Bus/Usb/UsbNetwork/UsbRndis/UsbRndisFunction.c
@@ -907,7 +907,50 @@ SetUsbRndisPacketFilter (
   IN UINT16                       Value
   )
 {
-  return EFI_SUCCESS;
+  USB_RNDIS_DEVICE  *UsbRndisDevice;
+  struct {
+    REMOTE_NDIS_SET_MSG    SetMsg;
+    UINT32                 Filter;
+  } RndisSetMsg;
+  REMOTE_NDIS_SET_CMPLT  RndisSetCmplt;
+  EFI_STATUS             Status;
+
+  //
+  // An RNDIS device passes no data until a packet filter is set. Callers
+  // hand in PXE or CDC filter bits depending on the path, so always ask for
+  // everything the network stack may need (unicast to us, broadcast, all
+  // multicast): the stack filters further in software.
+  //
+  UsbRndisDevice = USB_RNDIS_DEVICE_FROM_THIS (This);
+
+  ZeroMem (&RndisSetMsg, sizeof (RndisSetMsg));
+  ZeroMem (&RndisSetCmplt, sizeof (RndisSetCmplt));
+
+  RndisSetMsg.SetMsg.MessageType             = RNDIS_SET_MSG;
+  RndisSetMsg.SetMsg.MessageLength           = sizeof (RndisSetMsg);
+  RndisSetMsg.SetMsg.RequestID               = UsbRndisDevice->RequestId;
+  RndisSetMsg.SetMsg.Oid                     = OID_GEN_CURRENT_PACKET_FILTER;
+  RndisSetMsg.SetMsg.InformationBufferLength = sizeof (UINT32);
+  RndisSetMsg.SetMsg.InformationBufferOffset = sizeof (REMOTE_NDIS_SET_MSG) - 8;
+  RndisSetMsg.Filter                         = NDIS_PACKET_TYPE_DIRECTED | NDIS_PACKET_TYPE_MULTICAST |
+                                               NDIS_PACKET_TYPE_ALL_MULTICAST | NDIS_PACKET_TYPE_BROADCAST;
+
+  RndisSetCmplt.MessageType   = RNDIS_SET_CMPLT;
+  RndisSetCmplt.MessageLength = sizeof (REMOTE_NDIS_SET_CMPLT);
+
+  Status = RndisControlMsg (
+             UsbRndisDevice,
+             (REMOTE_NDIS_MSG_HEADER *)&RndisSetMsg,
+             (REMOTE_NDIS_MSG_HEADER *)&RndisSetCmplt
+             );
+  UsbRndisDevice->RequestId++;
+
+  if (!EFI_ERROR (Status) && (RndisSetCmplt.Status != 0)) {
+    Status = EFI_DEVICE_ERROR;
+  }
+
+  DEBUG ((DEBUG_INFO, "SetUsbRndisPacketFilter: %r (device status %x)\n", Status, RndisSetCmplt.Status));
+  return Status;
 }
 
 /**
@@ -1112,6 +1155,9 @@ RndisUndiInitialize (
   DEBUG ((DEBUG_INFO, "MaxTransferSize : %x\n", RndisInitMsgCmplt.MaxTransferSize));
   DEBUG ((DEBUG_INFO, "PacketAlignmentFactor : %x\n", RndisInitMsgCmplt.PacketAlignmentFactor));
 
+  // Without a packet filter the device never sends received frames
+  SetUsbRndisPacketFilter (UsbEthDriver, 0);
+
   return Status;
 }
 
