/** @file
  DBG2: UART0 (Synopsys DW APB UART, 16550 compatible, 32-bit registers).

  SPDX-License-Identifier: BSD-2-Clause-Patent
**/

#include <AcpiHelperMacros.h>
#include <IndustryStandard/DebugPort2Table.h>
#include "AcpiTables.h"

#define NAMESPACE_STRING  { '.', 0x00 }

#pragma pack (1)
typedef struct {
  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT    Dbg2Device;
  EFI_ACPI_6_3_GENERIC_ADDRESS_STRUCTURE           BaseAddressRegister;
  UINT32                                           AddressSize;
  UINT8                                            NameSpaceString[2];
} OPI_DBG2_DEVICE;

typedef struct {
  EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE    Description;
  OPI_DBG2_DEVICE                            Device;
} OPI_DBG2;
#pragma pack ()

OPI_DBG2  Dbg2 = {
  {
    ACPI_HEADER (EFI_ACPI_6_3_DEBUG_PORT_2_TABLE_SIGNATURE, OPI_DBG2, EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT_REVISION),
    OFFSET_OF (OPI_DBG2, Device),
    1
  },
  {
    {
      EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT_REVISION,
      sizeof (OPI_DBG2_DEVICE),
      1,                                              // NumberofGenericAddressRegisters
      2,                                              // NameSpaceStringLength
      OFFSET_OF (OPI_DBG2_DEVICE, NameSpaceString),
      0,                                              // OemDataLength
      0,                                              // OemDataOffset
      EFI_ACPI_DBG2_PORT_TYPE_SERIAL,
      EFI_ACPI_DBG2_PORT_SUBTYPE_SERIAL_16550_WITH_GAS,
      { EFI_ACPI_RESERVED_BYTE, EFI_ACPI_RESERVED_BYTE },
      OFFSET_OF (OPI_DBG2_DEVICE, BaseAddressRegister),
      OFFSET_OF (OPI_DBG2_DEVICE, AddressSize)
    },
    ACPI_GAS32 (H616_UART0_BASE),
    0x400,
    NAMESPACE_STRING
  }
};

VOID *CONST  ReferenceAcpiTable = &Dbg2;
